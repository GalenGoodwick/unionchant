{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "cd websocket-server && npm install"
  },
  "deploy": {
    "startCommand": "cd websocket-server && node server.js",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 10
  }
}
